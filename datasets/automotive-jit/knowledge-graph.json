  "extension_policy": {
    "rule": "An extension point is valid only for the target product, release and deployment model.",
    "preferred_order": ["configuration", "released_key_user_extensibility", "released_developer_extensibility_or_BAdI", "side_by_side_extension", "classic_enhancement_if_required_and_supported", "modification_last"],
    "agent_checklist": [
      "Identify classic vs Next Generation JIT first.",
      "Identify S/4HANA on-premise/private cloud/public cloud release.",
      "Verify the extension object in official SAP documentation for that release.",
      "Keep partner mapping and protocol transformation in the integration layer unless the rule is truly business-domain logic.",
      "Define rollback and reprocessing behavior for any extension executed in the JIT lifecycle."
    ]
