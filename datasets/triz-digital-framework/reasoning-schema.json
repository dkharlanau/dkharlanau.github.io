{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dkharlanau.github.io/datasets/triz-digital-framework/reasoning-schema.json",
  "title": "TRIZ Digital Reasoning Result",
  "description": "Structured output contract for contradiction-driven analysis of IT, business-process, integration, data, and AI problems.",
  "type": "object",
  "required": [
    "problem",
    "useful_function",
    "ideal_result",
    "contradiction",
    "separation",
    "resource_scan",
    "system_map",
    "options",
    "technology_allocation",
    "authority_chain",
    "experiment",
    "risks",
    "assumptions",
    "unknowns"
  ],
  "properties": {
    "problem": {
      "type": "object",
      "required": ["statement", "observed_behavior", "desired_outcome", "actors", "business_objects", "constraints"],
      "properties": {
        "statement": {"type": "string"},
        "observed_behavior": {"type": "array", "items": {"type": "string"}},
        "desired_outcome": {"type": "string"},
        "actors": {"type": "array", "items": {"type": "string"}},
        "business_objects": {"type": "array", "items": {"type": "string"}},
        "constraints": {"type": "array", "items": {"type": "string"}},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "boundary": {"type": "string"},
        "risk_tier": {"type": "string", "enum": ["R0", "R1", "R2", "R3"]}
      },
      "additionalProperties": true
    },
    "useful_function": {
      "type": "object",
      "required": ["actor", "action", "object", "outcome"],
      "properties": {
        "actor": {"type": "string"},
        "action": {"type": "string"},
        "object": {"type": "string"},
        "outcome": {"type": "string"},
        "current_mechanism": {"type": "string"}
      }
    },
    "ideal_result": {
      "type": "object",
      "required": ["statement", "complexity_to_avoid"],
      "properties": {
        "statement": {"type": "string"},
        "complexity_to_avoid": {"type": "array", "items": {"type": "string"}},
        "useful_outcomes": {"type": "array", "items": {"type": "string"}},
        "reliability_expectation": {"type": "string"}
      }
    },
    "contradiction": {
      "type": "object",
      "required": ["improving_property", "worsening_property", "statement", "type"],
      "properties": {
        "improving_property": {"type": "string"},
        "worsening_property": {"type": "string"},
        "statement": {"type": "string"},
        "type": {
          "type": "string",
          "enum": [
            "speed_control",
            "standard_flexible",
            "automation_accountability",
            "integration_coupling",
            "freshness_cost",
            "accuracy_latency",
            "context_privacy",
            "autonomy_trust",
            "specialization_handoffs",
            "local_global",
            "other"
          ]
        },
        "physical_form": {"type": "string"}
      }
    },
    "separation": {
      "type": "object",
      "required": ["tested_operators", "selected_operators"],
      "properties": {
        "tested_operators": {
          "type": "array",
          "items": {"type": "string", "enum": ["O1_time", "O2_condition", "O3_context", "O4_system_level", "O5_authority", "O6_representation"]}
        },
        "selected_operators": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "enum": ["O1_time", "O2_condition", "O3_context", "O4_system_level", "O5_authority", "O6_representation"]}
        },
        "reasoning": {"type": "array", "items": {"type": "string"}}
      }
    },
    "resource_scan": {
      "type": "object",
      "properties": {
        "information": {"type": "array", "items": {"type": "string"}},
        "time": {"type": "array", "items": {"type": "string"}},
        "structure": {"type": "array", "items": {"type": "string"}},
        "history": {"type": "array", "items": {"type": "string"}},
        "negative_signals": {"type": "array", "items": {"type": "string"}},
        "human_judgment": {"type": "array", "items": {"type": "string"}},
        "policy_permission": {"type": "array", "items": {"type": "string"}},
        "compute_attention": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "system_map": {
      "type": "object",
      "required": ["actors", "business_objects", "events", "decisions", "rules", "states", "side_effects"],
      "properties": {
        "actors": {"type": "array", "items": {"type": "string"}},
        "business_objects": {"type": "array", "items": {"type": "string"}},
        "events": {"type": "array", "items": {"type": "string"}},
        "decisions": {"type": "array", "items": {"type": "string"}},
        "rules": {"type": "array", "items": {"type": "string"}},
        "states": {"type": "array", "items": {"type": "string"}},
        "delays": {"type": "array", "items": {"type": "string"}},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "side_effects": {"type": "array", "items": {"type": "string"}},
        "relationships": {"type": "array", "items": {"type": "string"}}
      }
    },
    "selected_patterns": {
      "type": "array",
      "items": {"type": "string", "pattern": "^P(0[1-9]|1[0-2])$"}
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "name", "system_shape", "benefits", "complexity_tax", "reversibility"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "system_shape": {"type": "string"},
          "patterns": {"type": "array", "items": {"type": "string"}},
          "benefits": {"type": "array", "items": {"type": "string"}},
          "complexity_tax": {"type": "array", "items": {"type": "string"}},
          "reversibility": {"type": "string", "enum": ["high", "medium", "low"]},
          "new_dependencies": {"type": "array", "items": {"type": "string"}},
          "new_failure_modes": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "technology_allocation": {
      "type": "object",
      "properties": {
        "deterministic_rules": {"type": "array", "items": {"type": "string"}},
        "workflow": {"type": "array", "items": {"type": "string"}},
        "events": {"type": "array", "items": {"type": "string"}},
        "retrieval_or_read_tools": {"type": "array", "items": {"type": "string"}},
        "ai_models": {"type": "array", "items": {"type": "string"}},
        "agents": {"type": "array", "items": {"type": "string"}},
        "human_judgment": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "authority_chain": {
      "type": "object",
      "required": ["read", "propose", "validate", "approve", "execute"],
      "properties": {
        "read": {"type": "array", "items": {"type": "string"}},
        "propose": {"type": "array", "items": {"type": "string"}},
        "validate": {"type": "array", "items": {"type": "string"}},
        "approve": {"type": "array", "items": {"type": "string"}},
        "execute": {"type": "array", "items": {"type": "string"}}
      }
    },
    "experiment": {
      "type": "object",
      "required": ["hypothesis", "change", "primary_metric", "counter_metrics", "failure_condition", "scope"],
      "properties": {
        "hypothesis": {"type": "string"},
        "change": {"type": "string"},
        "primary_metric": {"type": "string"},
        "counter_metrics": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "failure_condition": {"type": "string"},
        "scope": {"type": "string"},
        "rollback_or_recovery": {"type": "string"}
      }
    },
    "risks": {"type": "array", "items": {"type": "string"}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "unknowns": {"type": "array", "items": {"type": "string"}},
    "decision": {
      "type": "object",
      "properties": {
        "preferred_option": {"type": "string"},
        "why": {"type": "string"},
        "next_evidence_needed": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "additionalProperties": false
}
