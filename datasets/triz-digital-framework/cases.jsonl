{"id":"case-order-exception-speed-control","domain":"business_process_ai","input":{"problem_statement":"Order exceptions wait in a shared queue and commercial teams spend too much time collecting context before deciding what to do.","observed_behavior":["long_waiting_time","manual_context_collection","repeated_exception_types"],"desired_outcome":"Resolve common exceptions earlier without giving an AI system broad permission to change commercial data.","actors":["sales_operations","order_management","approver"],"business_objects":["sales_order","customer","delivery_block","approval"],"constraints":["commercial_rules","authorization","auditability"],"evidence":["queue_age","resolved_exception_history","order_context","proposal_rejections"],"risk_tier":"R2"},"expected":{"useful_function":{"actor":"order_management","action":"resolve_valid_exception","object":"sales_order","outcome":"protect_delivery_flow_without_weakening_commercial_control"},"ideal_result":{"statement":"A valid exception is recognized and prepared for resolution before delivery risk appears, with minimal queueing and no broad autonomous write access.","complexity_to_avoid":["new_central_queue","broad_agent_write_access","duplicate_order_state"]},"contradiction":{"type":"automation_accountability","improving_property":"resolution_speed_and_manual_effort","worsening_property":"control_and_accountability","statement":"More automated resolution reduces waiting but broader mutation authority increases commercial risk.","physical_form":"The review should disappear for routine well-bounded exceptions and remain for business-significant changes."},"separation":{"tested_operators":["O1_time","O2_condition","O3_context","O4_system_level","O5_authority","O6_representation"],"selected_operators":["O2_condition","O5_authority"],"reasoning":["Route routine and high-impact exceptions differently.","Separate evidence gathering and proposal from approval and execution."]},"resource_scan":{"information":["order_context","commercial_rules"],"time":["queue_wait_before_delivery_risk"],"structure":["existing_order_read_api","approval_state"],"history":["resolved_exception_history"],"negative_signals":["rejected_proposals","post_change_corrections"],"human_judgment":["commercial_exception_approval"],"policy_permission":["authorization","mandatory_commercial_checks"],"compute_attention":["cheap_rule_checks","model_only_for_ambiguous_context"]},"system_map":{"actors":["sales_operations","order_management","approver"],"business_objects":["sales_order","customer","delivery_block","approval"],"events":["exception_created","proposal_prepared","approval_decided"],"decisions":["exception_class","business_significance","approve_change"],"rules":["commercial_constraints","authorization"],"states":["blocked","proposal_ready","approved","resolved"],"delays":["shared_queue_wait"],"evidence":["order_context","similar_cases","policy_checks"],"side_effects":["commercial_order_change"],"relationships":["exception_blocks_order","approval_controls_change"]},"selected_patterns":["P03","P06","P08","P09","P12"],"options":[{"id":"A","name":"Simplify routing and pre-validation","system_shape":"Deterministic exception classes, pre-validation and direct routing without AI.","patterns":["P04","P06","P11"],"benefits":["lower_waiting","low_runtime_complexity"],"complexity_tax":["maintain_exception_rules"],"reversibility":"high","new_dependencies":[],"new_failure_modes":["rule_coverage_gap"]},{"id":"B","name":"AI-assisted prepared change","system_shape":"Read-first AI classifies and summarizes evidence, then prepares a bounded change for deterministic validation and approval by risk tier.","patterns":["P03","P06","P08","P09","P12"],"benefits":["less_manual_context_collection","better_handling_of_messy_cases"],"complexity_tax":["model_evals","tool_governance","trace_review"],"reversibility":"high","new_dependencies":["model_service","retrieval_or_case_search"],"new_failure_modes":["misclassification","automation_bias"]}],"technology_allocation":{"deterministic_rules":["authorization","mandatory_commercial_checks","write_preconditions"],"workflow":["risk_tier_routing"],"events":[],"retrieval_or_read_tools":["order_context","similar_resolved_cases"],"ai_models":["exception_classification","evidence_summary","proposed_action"],"agents":[],"human_judgment":["approval_for_business_significant_change"]},"authority_chain":{"read":["ai_assistant"],"propose":["ai_assistant"],"validate":["commercial_rule_service"],"approve":["accountable_approver_for_R2"],"execute":["narrow_order_change_tool"]},"experiment":{"hypothesis":"Prepared evidence and bounded proposals reduce exception age without increasing control failures.","change":"Run an AI assistant in read-first mode for selected exception classes.","primary_metric":"median_exception_age","counter_metrics":["wrong_classification_rate","proposal_rejection_rate","post_change_correction_rate"],"failure_condition":"Control failures or correction cost increase beyond the agreed threshold.","scope":"selected_repeat_exception_classes","rollback_or_recovery":"disable_proposal_path_and_return_to_existing_queue"},"risks":["automation_bias","stale_context","overbroad_write_tool"],"assumptions":["historical_cases_are_reusable_enough_for_retrieval"],"unknowns":["acceptable_control_failure_threshold"]}}
{"id":"case-integration-freshness-coupling","domain":"integration_architecture","input":{"problem_statement":"Several consumers repeatedly poll a transactional system for status changes.","observed_behavior":["high_read_volume","consumer_source_dependency","duplicate_polling_logic"],"desired_outcome":"Keep consumers reasonably current while reducing source-system load and availability coupling.","actors":["source_system_owner","integration_team","consumer_teams"],"business_objects":["business_document","status_change","event"],"constraints":["delivery_semantics","ordering","replay","consumer_latency"],"evidence":["request_volume","consumer_data_age","polling_intervals"],"risk_tier":"R1"},"expected":{"useful_function":{"actor":"consumer_system","action":"learn_relevant_state_change","object":"business_document","outcome":"react_with_acceptable_freshness_without_source_coupling"},"ideal_result":{"statement":"Consumers react to relevant state changes without blocking the source transaction or continuously polling the source.","complexity_to_avoid":["consumer_specific_source_logic","duplicate_pollers","source_availability_dependency"]},"contradiction":{"type":"integration_coupling","improving_property":"data_freshness_and_consumer_awareness","worsening_property":"source_load_and_dependency","statement":"More frequent synchronous reads improve freshness but increase load and availability coupling.","physical_form":"Immediate confirmation should remain where required and disappear for reactions that can tolerate asynchronous delivery."},"separation":{"tested_operators":["O1_time","O2_condition","O3_context","O4_system_level","O5_authority","O6_representation"],"selected_operators":["O1_time","O4_system_level"],"reasoning":["Separate immediate confirmation from later reaction.","Move fan-out coordination from the source transaction to an event layer."]},"resource_scan":{"information":["business_status_changes"],"time":["consumer_freshness_tolerance"],"structure":["existing_integration_platform","business_keys"],"history":["polling_and_status_history"],"negative_signals":["timeouts","duplicate_requests"],"human_judgment":[],"policy_permission":["consumer_access_rules"],"compute_attention":["source_capacity","consumer_processing_capacity"]},"system_map":{"actors":["source_system_owner","integration_team","consumer_teams"],"business_objects":["business_document","event"],"events":["business_state_changed"],"decisions":["needs_immediate_confirmation"],"rules":["event_schema","idempotency","replay_policy"],"states":["source_state","consumer_projection"],"delays":["poll_interval","event_delivery_delay"],"evidence":["event_delivery_metrics","consumer_data_age"],"side_effects":["consumer_processing"],"relationships":["source_publishes_event","consumer_updates_projection"]},"selected_patterns":["P01","P05","P12"],"options":[{"id":"A","name":"Reduce and coordinate polling","system_shape":"Shared polling/cache layer reduces duplicate reads while keeping synchronous source access.","patterns":["P01","P04","P12"],"benefits":["lower_source_load","simpler_migration"],"complexity_tax":["shared_cache_state","staleness_policy"],"reversibility":"high","new_dependencies":["cache_or_shared_reader"],"new_failure_modes":["cache_staleness"]},{"id":"B","name":"Business event plus selective confirmation","system_shape":"Publish stable state-change events; keep synchronous read only for consumers that need immediate confirmation.","patterns":["P01","P05","P12"],"benefits":["lower_source_coupling","fan_out_reuse"],"complexity_tax":["event_semantics","replay_and_idempotency"],"reversibility":"medium","new_dependencies":["event_delivery_capability"],"new_failure_modes":["event_loss","duplicates","ordering_issue"]}],"technology_allocation":{"deterministic_rules":["event_schema","idempotency","correlation","replay_policy"],"workflow":[],"events":["publish_business_state_change"],"retrieval_or_read_tools":["synchronous_confirmation_only_when_needed"],"ai_models":[],"agents":[],"human_judgment":[]},"authority_chain":{"read":["consumers"],"propose":[],"validate":["event_contract_tests"],"approve":["interface_owner_for_schema_change"],"execute":["source_event_publisher"]},"experiment":{"hypothesis":"One stable business event can reduce source reads while preserving acceptable consumer freshness.","change":"Migrate one consumer from polling to an event plus selective confirmation.","primary_metric":"source_read_request_reduction","counter_metrics":["consumer_data_age","duplicate_processing_rate","missed_event_rate","replay_failure_rate"],"failure_condition":"Freshness or delivery reliability becomes worse than the polling baseline.","scope":"one_state_transition_and_one_consumer","rollback_or_recovery":"restore_polling_for_the_pilot_consumer"},"risks":["eventual_consistency","schema_drift","poor_event_ownership"],"assumptions":["relevant_state_changes_can_be_expressed_as_stable_business_events"],"unknowns":["consumer_freshness_tolerance_by_use_case"]}}
{"id":"case-master-data-quality-lead-time","domain":"master_data_process","input":{"problem_statement":"Every master-data request follows the same review chain although many requests fail only predictable completeness or duplicate checks.","observed_behavior":["long_approval_cycle","repeatable_validation_work","duplicate_candidate_review"],"desired_outcome":"Shorten request lead time without reducing master-data quality.","actors":["requester","data_steward","approver"],"business_objects":["master_data_request","business_partner_or_product","approval"],"constraints":["mandatory_fields","duplicate_policy","governance_rules"],"evidence":["rejection_reasons","cycle_time","duplicate_decisions"],"risk_tier":"R2"},"expected":{"useful_function":{"actor":"data_governance","action":"create_or_change_valid_master_data","object":"master_data_record","outcome":"usable_unique_governed_data_with_low_lead_time"},"ideal_result":{"statement":"Exact quality checks happen before human review and people spend time only on ambiguous or policy-sensitive cases.","complexity_to_avoid":["same_review_chain_for_every_case","duplicate_manual_validation"]},"contradiction":{"type":"speed_control","improving_property":"data_quality_control","worsening_property":"request_lead_time","statement":"More review can protect data quality but increases lead time and steward effort.","physical_form":"Human review should exist for ambiguous or policy-sensitive cases and should not exist for exact routine validation."},"separation":{"tested_operators":["O1_time","O2_condition","O3_context","O4_system_level","O5_authority","O6_representation"],"selected_operators":["O1_time","O2_condition"],"reasoning":["Run exact checks before the approval moment.","Route ambiguous duplicate and policy cases to humans while routine checks stay straight-through."]},"resource_scan":{"information":["existing_master_data","validation_rules"],"time":["pre_approval_window"],"structure":["request_workflow","duplicate_search"],"history":["steward_decisions","rejected_requests"],"negative_signals":["downstream_corrections","false_duplicate_flags"],"human_judgment":["ambiguous_duplicate_decision","policy_exception"],"policy_permission":["governance_rules","approval_roles"],"compute_attention":["deterministic_checks_first","similarity_only_for_candidate_ranking"]},"system_map":{"actors":["requester","data_steward","approver"],"business_objects":["master_data_request","master_data_record","approval"],"events":["request_submitted","validation_failed","duplicate_candidate_found","approved"],"decisions":["is_complete","is_duplicate","policy_exception"],"rules":["mandatory_fields","format_rules","governance_rules"],"states":["draft","prevalidated","needs_review","approved","rejected"],"delays":["approval_queue"],"evidence":["validation_result","duplicate_candidates","steward_reason"],"side_effects":["create_or_change_master_data"],"relationships":["request_targets_record","approval_controls_change"]},"selected_patterns":["P02","P06","P11","P09"],"options":[{"id":"A","name":"Deterministic pre-validation","system_shape":"Move all exact completeness and policy checks before approval and route failures directly back to the requester.","patterns":["P04","P11"],"benefits":["lower_steward_load","faster_feedback"],"complexity_tax":["maintain_validation_rules"],"reversibility":"high","new_dependencies":[],"new_failure_modes":["rule_gap"]},{"id":"B","name":"Pre-validation plus similarity evidence","system_shape":"Exact checks run first; similarity search or AI ranks duplicate candidates and packages evidence for ambiguous review.","patterns":["P02","P06","P09","P11"],"benefits":["faster_duplicate_review","less_manual_search"],"complexity_tax":["similarity_evals","evidence_explanation"],"reversibility":"high","new_dependencies":["similarity_or_model_service"],"new_failure_modes":["false_similarity","rubber_stamp_review"]}],"technology_allocation":{"deterministic_rules":["mandatory_field_validation","format_rules","stable_governance_rules"],"workflow":["condition_based_review"],"events":[],"retrieval_or_read_tools":["duplicate_candidate_search"],"ai_models":["unstructured_request_interpretation","evidence_summary_if_needed"],"agents":[],"human_judgment":["ambiguous_duplicate_decision","policy_exception"]},"authority_chain":{"read":["validator","similarity_service","data_steward"],"propose":["similarity_or_ai_assistant"],"validate":["governance_rule_service"],"approve":["data_steward_or_approver_for_ambiguous_case"],"execute":["master_data_workflow"]},"experiment":{"hypothesis":"Pre-validation and ranked evidence reduce approval cycle time without increasing duplicate or downstream defects.","change":"Pre-validate exact rules and surface ranked duplicate evidence before approval.","primary_metric":"approval_cycle_time","counter_metrics":["missed_duplicate_rate","downstream_correction_rate","false_duplicate_alert_rate"],"failure_condition":"Quality defects increase despite lower lead time.","scope":"one_master_data_request_type","rollback_or_recovery":"return_duplicate_ranking_to_advisory_only"},"risks":["poor_reference_data","false_similarity","rubber_stamp_review"],"assumptions":["duplicate_decisions_have_reusable_evidence"],"unknowns":["acceptable_false_duplicate_rate"]}}
{"id":"case-global-process-local-rules","domain":"business_process_architecture","input":{"problem_statement":"A global process template keeps growing country and business-unit branches until the common process becomes difficult to understand and change.","observed_behavior":["branch_growth","slow_global_change","local_workarounds"],"desired_outcome":"Preserve enterprise policy while allowing valid local variation without duplicating the whole process.","actors":["global_process_owner","local_process_owner","compliance"],"business_objects":["process_definition","policy","local_rule","exception"],"constraints":["global_controls","local_regulation","auditability"],"evidence":["variant_count","change_lead_time","local_workarounds"],"risk_tier":"R2"},"expected":{"useful_function":{"actor":"process_owner","action":"govern_end_to_end_process","object":"process_variant","outcome":"common_control_with_valid_local_fit"},"ideal_result":{"statement":"Stable global states and policy remain common while contextual local decisions are isolated behind explicit rule boundaries.","complexity_to_avoid":["global_branch_explosion","full_process_copy_per_country"]},"contradiction":{"type":"standard_flexible","improving_property":"global_standardization","worsening_property":"local_fit_and_change_speed","statement":"More central standardization simplifies governance but can make valid local change slow or force workarounds.","physical_form":"The process should be common for enterprise policy and different where local context legitimately changes the decision."},"separation":{"tested_operators":["O1_time","O2_condition","O3_context","O4_system_level","O5_authority","O6_representation"],"selected_operators":["O3_context","O4_system_level"],"reasoning":["Separate stable global policy from contextual local rules.","Keep enterprise states at a higher system level than local execution detail."]},"resource_scan":{"information":["global_policy","local_regulation"],"time":["local_change_lead_time"],"structure":["extension_points","decision_tables"],"history":["variant_changes","workarounds"],"negative_signals":["policy_violations","local_workarounds"],"human_judgment":["governance_of_new_exception_type"],"policy_permission":["global_control_ownership","local_rule_ownership"],"compute_attention":[]},"system_map":{"actors":["global_process_owner","local_process_owner","compliance"],"business_objects":["process_definition","policy","local_rule"],"events":["policy_changed","local_rule_changed"],"decisions":["global_or_local_rule","approve_new_local_exception_type"],"rules":["global_policy","local_regulation"],"states":["common_process_state","local_decision_state"],"delays":["global_change_cycle"],"evidence":["variant_metrics","policy_violation"],"side_effects":["process_behavior_change"],"relationships":["global_policy_constrains_local_rule"]},"selected_patterns":["P01","P04","P07","P12"],"options":[{"id":"A","name":"Prune and govern branches","system_shape":"Keep one process definition but remove redundant branches and make exception ownership explicit.","patterns":["P04","P11","P12"],"benefits":["lower_branch_count","minimal_architecture_change"],"complexity_tax":["continued_common_model_growth"],"reversibility":"high","new_dependencies":[],"new_failure_modes":["branch_regrowth"]},{"id":"B","name":"Common state plus local decision layer","system_shape":"Keep common process states and policy globally; isolate contextual local decisions in governed rule or extension boundaries.","patterns":["P01","P04","P07","P12"],"benefits":["faster_local_change","clear_global_policy"],"complexity_tax":["local_rule_governance","boundary_contract"],"reversibility":"medium","new_dependencies":["decision_or_extension_layer"],"new_failure_modes":["policy_fragmentation"]}],"technology_allocation":{"deterministic_rules":["global_policy","local_decision_tables"],"workflow":["common_process_skeleton"],"events":[],"retrieval_or_read_tools":[],"ai_models":[],"agents":[],"human_judgment":["governance_of_new_local_exception_types"]},"authority_chain":{"read":["global_and_local_owners"],"propose":["local_process_owner"],"validate":["global_policy_checks"],"approve":["appropriate_global_or_local_governance_role"],"execute":["governed_rule_or_process_change"]},"experiment":{"hypothesis":"Extracting one high-variation branch into a governed local decision layer reduces global complexity without creating control gaps.","change":"Move one high-variation branch behind an explicit local decision boundary while keeping common states unchanged.","primary_metric":"global_process_branch_count","counter_metrics":["policy_violation_rate","local_workaround_rate","local_change_lead_time"],"failure_condition":"Local divergence creates new enterprise control gaps.","scope":"one_country_or_business_unit_variant","rollback_or_recovery":"restore_original_branch_and_remove_local_rule"},"risks":["policy_fragmentation","duplicate_local_rules","unclear_ownership"],"assumptions":["global_and_local_rules_can_be_distinguished"],"unknowns":["which_variations_are_truly_local"]}}
{"id":"case-operations-agent-autonomy-trust","domain":"ai_operations","input":{"problem_statement":"An operations assistant can investigate incidents across several systems, but direct remediation tools would create a large blast radius.","observed_behavior":["manual_cross_system_diagnosis","slow_evidence_collection","high_impact_remediation"],"desired_outcome":"Use agentic investigation to reduce diagnosis time without turning model reasoning into production authorization.","actors":["operations_engineer","service_owner","approver"],"business_objects":["incident","system_state","diagnostic_evidence","prepared_change"],"constraints":["least_privilege","production_safety","auditability","time_budget"],"evidence":["incident_history","telemetry","runbooks"],"risk_tier":"R3"},"expected":{"useful_function":{"actor":"operations_engineer","action":"diagnose_and_prepare_safe_remediation","object":"incident","outcome":"restore_service_quickly_without_uncontrolled_production_change"},"ideal_result":{"statement":"The agent investigates adaptively with read tools, stops on insufficient evidence, and can prepare but not authorize high-impact remediation.","complexity_to_avoid":["broad_write_scope","hidden_agent_state","unbounded_tool_loop"]},"contradiction":{"type":"autonomy_trust","improving_property":"diagnosis_speed_and_adaptability","worsening_property":"operational_safety_and_control","statement":"More agent autonomy can improve diagnosis but increases the impact of wrong actions.","physical_form":"The agent should be autonomous while investigating and should not be autonomous when authorizing high-impact production mutation."},"separation":{"tested_operators":["O1_time","O2_condition","O3_context","O4_system_level","O5_authority","O6_representation"],"selected_operators":["O1_time","O5_authority"],"reasoning":["Learn in replay and shadow mode before mutation.","Separate read and proposal capability from validation, approval and execution authority."]},"resource_scan":{"information":["system_state","runbooks"],"time":["historical_replay","shadow_period"],"structure":["read_only_apis","existing_approval_flow"],"history":["incidents","remediation_outcomes"],"negative_signals":["failed_tool_calls","unsafe_proposals"],"human_judgment":["high_impact_execution_approval"],"policy_permission":["tool_allowlist","production_authorization"],"compute_attention":["model_and_tool_call_budgets"]},"system_map":{"actors":["operations_engineer","service_owner","approver","agent"],"business_objects":["incident","system_state","prepared_change"],"events":["incident_opened","evidence_found","proposal_prepared","approval_decided"],"decisions":["next_read_action","sufficient_evidence","safe_remediation"],"rules":["tool_allowlist","budgets","preconditions","authorization"],"states":["investigating","insufficient_evidence","proposal_ready","approved","executed"],"delays":["manual_cross_system_search"],"evidence":["telemetry","tool_results","trajectory_trace"],"side_effects":["production_remediation"],"relationships":["agent_reads_systems","approver_controls_high_impact_execution"]},"selected_patterns":["P03","P08","P10","P12"],"options":[{"id":"A","name":"Deterministic diagnostic workflow","system_shape":"Known diagnostic steps and read tools run in a fixed workflow with explicit escalation.","patterns":["P04","P12"],"benefits":["high_repeatability","simple_evals"],"complexity_tax":["weak_edge_case_adaptation"],"reversibility":"high","new_dependencies":[],"new_failure_modes":["workflow_dead_end"]},{"id":"B","name":"Bounded read-first agent","system_shape":"Agent chooses the next read action from an allowlist, prepares remediation, and hands validation/approval/execution to deterministic controls and accountable roles.","patterns":["P03","P08","P10","P12"],"benefits":["adaptive_investigation","less_manual_search"],"complexity_tax":["trajectory_evals","agent_observability","budget_controls"],"reversibility":"high","new_dependencies":["model_service","tool_gateway"],"new_failure_modes":["looping","prompt_injection","tool_overreach"]}],"technology_allocation":{"deterministic_rules":["tool_allowlist","budgets","preconditions","authorization","idempotency"],"workflow":["approval_and_execution"],"events":[],"retrieval_or_read_tools":["telemetry","runbooks","system_state"],"ai_models":["hypothesis_generation"],"agents":["bounded_read_tool_loop","next_read_action","prepared_change"],"human_judgment":["high_impact_execution_approval"]},"authority_chain":{"read":["bounded_agent"],"propose":["bounded_agent"],"validate":["policy_and_precondition_service"],"approve":["accountable_human_for_R3"],"execute":["narrow_remediation_tool"]},"experiment":{"hypothesis":"A read-first bounded agent reduces diagnosis time without increasing unsafe remediation proposals.","change":"Run the agent in shadow mode on historical and selected live incidents with read-only tools.","primary_metric":"correct_diagnosis_rate_and_time_saved","counter_metrics":["unsafe_proposal_rate","unnecessary_tool_steps","missing_evidence_rate","unnecessary_escalation_rate"],"failure_condition":"The agent cannot reliably stop, explain evidence, or avoid unsafe proposals.","scope":"historical_replay_plus_selected_live_shadow_incidents","rollback_or_recovery":"disable_agent_and_keep_existing_diagnostic_flow"},"risks":["prompt_injection","tool_overreach","looping","sensitive_data_in_trace"],"assumptions":["read_tools_expose_enough_evidence_for_diagnosis"],"unknowns":["acceptable_agent_loop_budget_by_incident_class"]}}
{"id":"case-sap-sales-credit-block-speed-risk","domain":"sap_sales_process","input":{"problem_statement":"Credit-blocked sales orders can wait for review even when many cases are routine and evidence collection is repetitive.","observed_behavior":["credit_block_waiting","manual_financial_context_collection","mixed_risk_cases_in_same_queue"],"desired_outcome":"Reduce order block age without weakening commercial credit control.","actors":["sales_operations","credit_analyst","approver"],"business_objects":["sales_order","customer_credit_exposure","credit_block","release_decision"],"constraints":["credit_policy","authorization","segregation_of_duties","auditability"],"evidence":["block_age","order_value","credit_status","overdue_exposure","past_release_decisions"],"risk_tier":"R2"},"expected":{"useful_function":{"actor":"credit_management","action":"release_or_keep_blocked_order","object":"sales_order","outcome":"protect_customer_flow_and_credit_risk"},"ideal_result":{"statement":"Routine credit blocks receive complete evidence quickly while material exceptions retain accountable release control.","complexity_to_avoid":["same_manual_review_for_every_block","full_finance_data_exposure_to_ai","broad_release_tool"]},"contradiction":{"type":"speed_control","improving_property":"sales_order_release_speed","worsening_property":"commercial_credit_risk_control","statement":"Faster release improves order flow but weaker review can increase credit exposure.","physical_form":"Independent review should remain for material credit exceptions and should not consume the same effort for routine low-risk blocks."},"separation":{"tested_operators":["O1_time","O2_condition","O3_context","O4_system_level","O5_authority","O6_representation"],"selected_operators":["O1_time","O2_condition","O5_authority","O6_representation"],"reasoning":["Prepare evidence before analyst review.","Separate routine and material exceptions.","Separate summarization from release authority.","Expose only the credit