{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dkharlanau.github.io/reusable-data-procedures/procedure.schema.json",
  "title": "Reusable Data Procedure",
  "description": "Portable business and data logic contract. Environment bindings, paths, secrets, scheduling, retry and run evidence are separate deployment and run artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "specVersion",
    "id",
    "name",
    "purpose",
    "catalog",
    "lifecycle",
    "sources",
    "transforms",
    "validations",
    "outputs",
    "provenance"
  ],
  "properties": {
    "kind": {
      "const": "reusable-data-procedure"
    },
    "specVersion": {
      "const": "0.5"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "procedureVersion": {
      "type": "string",
      "default": "0.1.0"
    },
    "owner": {
      "type": "string"
    },
    "technicalSteward": {
      "type": "string"
    },
    "catalog": {
      "$ref": "#/$defs/catalogMetadata"
    },
    "lifecycle": {
      "$ref": "#/$defs/lifecycle"
    },
    "dependencies": {
      "$ref": "#/$defs/dependencies"
    },
    "consumers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourceContract"
      }
    },
    "mappings": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/mapping"
      }
    },
    "transforms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/transform"
      }
    },
    "validations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/validation"
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/output"
      }
    },
    "behaviorPolicy": {
      "$ref": "#/$defs/behaviorPolicy"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "$defs": {
    "catalogMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "jobFamily",
        "sensitivity",
        "criticality"
      ],
      "properties": {
        "domain": {
          "type": "string"
        },
        "jobFamily": {
          "enum": [
            "clean",
            "enrich",
            "reconcile",
            "compare",
            "consolidate",
            "validate",
            "migrate",
            "publish",
            "other"
          ]
        },
        "dataConcepts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sourceFamilies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sensitivity": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ]
        },
        "criticality": {
          "enum": [
            "ad-hoc",
            "operational",
            "business-critical"
          ]
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maturity"
      ],
      "properties": {
        "maturity": {
          "enum": [
            "idea",
            "draft",
            "pilot",
            "approved",
            "deprecated"
          ]
        },
        "trustEvidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "regression-tested",
              "owner-reviewed",
              "production-proven",
              "fresh-review",
              "policy-cleared",
              "drift-observed"
            ]
          }
        },
        "lastReviewedAt": {
          "type": "string",
          "format": "date-time"
        },
        "reviewDueAt": {
          "type": "string",
          "format": "date-time"
        },
        "deprecatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "replacementProcedure": {
          "type": "string"
        }
      }
    },
    "dependencyRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "optional": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependencyRef"
          }
        },
        "procedures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependencyRef"
          }
        },
        "referenceData": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependencyRef"
          }
        },
        "externalSystems": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "fieldContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "required"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "type": {
          "enum": [
            "string",
            "integer",
            "number",
            "boolean",
            "date",
            "datetime",
            "unknown"
          ]
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "role": {
          "enum": [
            "key",
            "attribute",
            "measure",
            "date",
            "status",
            "unknown"
          ]
        },
        "nullable": {
          "type": "boolean"
        },
        "locale": {
          "type": "string"
        },
        "comparisonKey": {
          "type": "string"
        }
      }
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy"
      ],
      "properties": {
        "strategy": {
          "enum": [
            "excel-table",
            "named-range",
            "header-anchor",
            "header-score",
            "region-score",
            "fixed-range"
          ]
        },
        "name": {
          "type": "string"
        },
        "requiredHeaders": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "optionalHeaders": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scanFirstRows": {
          "type": "integer",
          "minimum": 1
        },
        "fixedRange": {
          "type": "string"
        },
        "minimumScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "fallback": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/locator"
          }
        }
      }
    },
    "extractionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stopAfterBlankRows": {
          "type": "integer",
          "minimum": 0
        },
        "removeRepeatedHeaders": {
          "type": "boolean"
        },
        "detectFooters": {
          "type": "boolean"
        },
        "includeHiddenRows": {
          "type": "boolean"
        },
        "includeHiddenColumns": {
          "type": "boolean"
        },
        "formulaMode": {
          "enum": [
            "cached-value",
            "formula",
            "both"
          ]
        },
        "preserveSourceCoordinates": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "sourceContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "requiredFields"
      ],
      "properties": {
        "role": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "description": {
          "type": "string"
        },
        "acceptedFormats": {
          "type": "array",
          "items": {
            "enum": [
              "csv",
              "tsv",
              "xlsx",
              "xlsm",
              "parquet",
              "json",
              "database",
              "api"
            ]
          }
        },
        "filePattern": {
          "type": "string"
        },
        "sheetPattern": {
          "type": "string"
        },
        "locators": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/locator"
          }
        },
        "extraction": {
          "$ref": "#/$defs/extractionPolicy"
        },
        "requiredFields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fieldContract"
          }
        },
        "optionalFields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fieldContract"
          }
        },
        "fingerprintPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "useColumnNames": {
              "type": "boolean",
              "default": true
            },
            "useTypes": {
              "type": "boolean",
              "default": true
            },
            "useValuePatterns": {
              "type": "boolean",
              "default": true
            },
            "useWorkbookStructure": {
              "type": "boolean",
              "default": true
            }
          }
        }
      }
    },
    "mappingEvidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "headerSimilarity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "valueOverlap": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "typeCompatibility": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "dictionaryMatch": {
          "type": "boolean"
        },
        "previousApproval": {
          "type": "boolean"
        },
        "semanticConfidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "approvedBy": {
          "type": "string"
        },
        "approvedAt": {
          "type": "string",
          "format": "date-time"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to",
        "cardinality",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "cardinality": {
          "enum": [
            "one-to-one",
            "one-to-many",
            "many-to-one",
            "many-to-many",
            "unknown"
          ]
        },
        "normalization": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "$ref": "#/$defs/mappingEvidence"
        }
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "op"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "op": {
          "enum": [
            "select",
            "rename",
            "cast",
            "trim",
            "normalize-space",
            "parse-null",
            "parse-date",
            "parse-decimal",
            "comparison-key",
            "filter",
            "lookup",
            "derive",
            "aggregate",
            "deduplicate",
            "sort",
            "route-exceptions",
            "block-ref",
            "custom"
          ]
        },
        "input": {
          "type": [
            "string",
            "array"
          ],
          "items": {
            "type": "string"
          }
        },
        "output": {
          "type": "string"
        },
        "params": {
          "type": "object"
        },
        "mappingRef": {
          "type": "string"
        },
        "blockRef": {
          "$ref": "#/$defs/dependencyRef"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "rule",
        "severity"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "rule": {
          "enum": [
            "schema-compatible",
            "locator-confidence",
            "not-null",
            "unique",
            "referential-integrity",
            "mapping-coverage",
            "parse-success",
            "row-count",
            "control-total",
            "value-domain",
            "expression",
            "block-ref",
            "custom"
          ]
        },
        "target": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error",
            "block"
          ]
        },
        "params": {
          "type": "object"
        },
        "blockRef": {
          "$ref": "#/$defs/dependencyRef"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "role": {
          "enum": [
            "result",
            "exceptions",
            "evidence",
            "intermediate"
          ]
        },
        "format": {
          "enum": [
            "csv",
            "xlsx",
            "parquet",
            "json",
            "table",
            "none"
          ]
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": "string"
        }
      }
    },
    "behaviorPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "onAmbiguousLocator": {
          "enum": [
            "quarantine",
            "manual-review",
            "stop"
          ],
          "default": "manual-review"
        },
        "onBreakingDrift": {
          "enum": [
            "stop",
            "manual-review"
          ],
          "default": "stop"
        },
        "onValidationFailure": {
          "enum": [
            "stop",
            "produce-exceptions",
            "manual-review"
          ],
          "default": "stop"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "createdAt"
      ],
      "properties": {
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdBy": {
          "type": "string"
        },
        "basedOnProcedureVersion": {
          "type": "string"
        },
        "changeReason": {
          "type": "string"
        },
        "sourceRunId": {
          "type": "string"
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time"
        },
        "reviewedBy": {
          "type": "string"
        }
      }
    }
  }
}