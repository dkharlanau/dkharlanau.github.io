{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dkharlanau.github.io/reusable-data-procedures/semantic-concept.schema.json",
  "title": "Semantic Concept",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "specVersion", "id", "label", "domain", "definition", "valueKind", "representation", "owner", "lifecycle"],
  "properties": {
    "kind": {"const": "semantic-concept"},
    "specVersion": {"const": "0.1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
    "label": {"type": "string"},
    "domain": {"type": "string"},
    "definition": {"type": "string"},
    "scopeNote": {"type": "string"},
    "owner": {"type": "string"},
    "valueKind": {"enum": ["identifier", "code", "text", "quantity", "amount", "date", "datetime", "boolean", "status", "other"]},
    "representation": {"type": "object", "additionalProperties": false, "required": ["logicalType"], "properties": {"logicalType": {"enum": ["string", "integer", "number", "boolean", "date", "datetime"]}, "leadingZeros": {"enum": ["significant", "representation-sensitive", "not-significant", "not-applicable"]}, "caseSensitive": {"type": "boolean"}, "localeSensitive": {"type": "boolean"}, "formatPattern": {"type": "string"}, "comparisonRule": {"type": "string"}}},
    "aliases": {"type": "array", "items": {"type": "string"}},
    "bindings": {"type": "array", "items": {"type": "object", "additionalProperties": false, "properties": {"system": {"type": "string"}, "sourceFamily": {"type": "string"}, "object": {"type": "string"}, "field": {"type": "string"}, "headerAlias": {"type": "string"}, "context": {"type": "string"}, "confidence": {"enum": ["known", "reviewed", "candidate"]}}}},
    "relations": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["type", "concept"], "properties": {"type": {"enum": ["broader-than", "narrower-than", "related-to", "derived-from", "equivalent-in-scope"]}, "concept": {"type": "string"}, "note": {"type": "string"}}}},
    "validationHints": {"type": "array", "items": {"type": "string"}},
    "referenceDatasets": {"type": "array", "items": {"type": "string"}},
    "lifecycle": {"type": "object", "additionalProperties": false, "required": ["status"], "properties": {"status": {"enum": ["draft", "review", "approved", "deprecated"]}, "reviewedAt": {"type": "string", "format": "date-time"}, "reviewedBy": {"type": "string"}, "replacement": {"type": "string"}}}
  }
}