{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dkharlanau.github.io/products/validation-record.schema.json",
  "title": "Portfolio external validation record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "product_id",
    "validation_dimension",
    "performed_at",
    "participant",
    "product_ref",
    "task",
    "setup",
    "outcome",
    "friction",
    "failures",
    "workarounds",
    "participant_feedback",
    "limitations",
    "evidence_retention"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "record_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
    },
    "cohort_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_ordinal": {
      "type": "integer",
      "minimum": 1
    },
    "product_id": {
      "type": "string",
      "minLength": 1
    },
    "validation_dimension": {
      "enum": [
        "usability",
        "correctness",
        "production_suitability"
      ]
    },
    "performed_at": {
      "type": "string",
      "format": "date-time"
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "independent",
        "authored_test_fixture",
        "role_archetype"
      ],
      "properties": {
        "independent": {
          "const": true
        },
        "authored_test_fixture": {
          "const": false
        },
        "role_archetype": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "product_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^https://github\\.com/[^/]+/[^/]+$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,40}$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "contract_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "input_class",
        "privacy_handling"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "input_class": {
          "enum": [
            "real",
            "independently_prepared_representative"
          ]
        },
        "privacy_handling": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "author_assistance"
      ],
      "properties": {
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "author_assistance": {
          "type": "boolean"
        },
        "assistance_notes": {
          "type": "string"
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "summary"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "partial",
            "failed",
            "inconclusive"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "expected_result_basis": {
          "type": "string"
        }
      }
    },
    "friction": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "workarounds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "participant_feedback": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "description"
      ],
      "properties": {
        "class": {
          "enum": [
            "private_local",
            "secure_org_system",
            "public_sanitized"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "public_artifact": {
          "type": "string",
          "format": "uri"
        }
      }
    }
  }
}
