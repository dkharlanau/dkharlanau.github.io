{
  "schema_version": "1.2",
  "name": "enterprise-transformation-toolkit",
  "human_url": "https://dkharlanau.github.io/products/",
  "architecture_source": "https://github.com/dkharlanau/dkharlanau.github.io/blob/main/products/ARCHITECTURE.md",
  "owner": "dkharlanau",
  "principles": [
    "human-readable-first",
    "deterministic",
    "evidence-over-assertions",
    "composable",
    "agent-compatible",
    "one-semantic-owner"
  ],
  "architecture": {
    "entry_rule": "Start from one user problem; adopting one product does not require adopting the full portfolio.",
    "source_of_truth_rule": "A maintained business semantic has one owning product. Consumers reference it with stable identity and provenance where supported rather than maintaining a second copy.",
    "projection_rule": "Derived artifacts identify their upstream source and remain deterministically regenerable; a projection is not automatically a new source of truth.",
    "detached_snapshot_rule": "A self-contained copied projection is allowed for archive, fixture or handoff use only when its detached lifecycle is explicit.",
    "graph_rule": "There is no universal writable enterprise graph; domain graphs remain bounded and connect through stable external references."
  },
  "entrypoints": [
    {"problem":"describe-workflow","product":"process-as-code"},
    {"problem":"make-deterministic-business-decision","product":"decision-tables-as-code"},
    {"problem":"document-integration-contract","product":"interface-as-code"},
    {"problem":"govern-source-target-transformation","product":"mapping-as-code"},
    {"problem":"prove-migration-or-replication-state","product":"reconciliation-as-code"},
    {"problem":"coordinate-cutover-readiness","product":"cutover-graph"},
    {"problem":"connect-claims-to-evidence","product":"project-evidence-graph"},
    {"problem":"render-structured-business-visual","product":"visual-workbench"},
    {"problem":"operate-sap-through-bounded-agent-capabilities","product":"sap-agentic-operations"},
    {"problem":"turn-source-into-evidence-backed-learning","product":"signal-to-insight"},
    {"problem":"resolve-public-agent-machine-interfaces","product":"agent-ready-web-profile"}
  ],
  "layers": {
    "intent_contracts": ["process-as-code", "decision-tables-as-code", "mapping-as-code", "interface-as-code"],
    "relationships_impact": ["data-relationship-map", "transformation-graph", "enterprise-change-graph"],
    "assurance_execution": ["reconciliation-as-code", "cutover-graph", "project-evidence-graph", "sap-agentic-operations"],
    "visual_learning": ["visual-workbench", "signal-to-insight"],
    "agent_interoperability": ["agent-ready-web-profile"]
  },
