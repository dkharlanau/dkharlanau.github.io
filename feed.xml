---
layout: null
permalink: /feed.xml
sitemap: false
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="en">
  <id>{{ '/' | absolute_url }}</id>
  <title>{{ site.title | xml_escape }}</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <link href="{{ page.url | absolute_url }}" rel="self" type="application/atom+xml" />
  <link href="{{ '/' | absolute_url }}" rel="alternate" type="text/html" />
  <link href="{{ '/rss.xml' | absolute_url }}" rel="alternate" type="application/rss+xml" />
  <author><name>{{ site.author.name | xml_escape }}</name></author>
  {% assign entries = site.blog | where: 'verified', true | where: 'status', 'reviewed' | sort: 'date' | reverse %}
  {% for entry in entries limit: 20 %}
  <entry>
    <id>{{ entry.url | absolute_url }}</id>
    <title type="html">{{ entry.title | xml_escape }}</title>
    <link href="{{ entry.url | absolute_url }}" rel="alternate" type="text/html" />
    <published>{{ entry.date | date_to_xmlschema }}</published>
    <updated>{{ entry.last_modified_at | default: entry.updated | default: entry.date | date_to_xmlschema }}</updated>
    <summary type="html">{{ entry.description | default: entry.excerpt | strip_html | normalize_whitespace | xml_escape }}</summary>
  </entry>
  {% endfor %}
</feed>
