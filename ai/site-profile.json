      {
        "name": "Dataset manifest",
        "url": "https://dkharlanau.github.io/datasets/manifest.json",
        "mediaType": "application/json",
        "role": "catalog",
        "description": "Public dataset manifest for the professional knowledge site."
      },
      {
        "name": "SAP Atlas compact index",
        "url": "https://dkharlanau.github.io/ai/atlas-compact-index.json",
        "mediaType": "application/json",
        "role": "search-index",
        "description": "Compact structured index over reviewed SAP Atlas material."
      },
      {
        "name": "Page knowledge index",
        "url": "https://dkharlanau.github.io/ai/page-knowledge-index.json",
        "mediaType": "application/json",
        "role": "search-index",
        "description": "Machine-readable routing index connecting public pages to canonical entities and AI sidecars."
      },
      {
        "name": "Canonical entity graph",
        "url": "https://dkharlanau.github.io/ai/entity-graph.jsonld",
        "mediaType": "application/ld+json",
        "role": "other",
        "description": "JSON-LD graph connecting the person, website and public machine-readable identity surfaces."
      },
      {
        "name": "AI Search & Citation Profile",
        "url": "https://dkharlanau.github.io/ai/ai-search-profile.json",
        "mediaType": "application/json",
        "role": "other",
        "description": "Site-specific implementation profile for citation-ready, machine-discoverable and trust-oriented surfaces."
      },
      {
        "name": "AI crawler access matrix",
        "url": "https://dkharlanau.github.io/crawler-matrix/crawlers.json",
        "mediaType": "application/json",
        "role": "other",
        "description": "Dated machine-readable representation of the site's published AI/search crawler policy."
      },
      {
        "name": "Trust Center",
        "url": "https://dkharlanau.github.io/trust/trust.json",
        "mediaType": "application/json",
        "role": "other",
        "description": "Machine-readable trust, evidence, correction and security boundaries for the site."
      }
    ]
  },
  "retrieval": {
    "indexes": [
      {
        "name": "SAP Atlas compact index",
        "url": "https://dkharlanau.github.io/ai/atlas-compact-index.json",
        "mediaType": "application/json",
        "format": "json",
        "description": "Compact public retrieval index over reviewed SAP Atlas content."
      },
      {
        "name": "Page knowledge index",
        "url": "https://dkharlanau.github.io/ai/page-knowledge-index.json",
        "mediaType": "application/json",
        "format": "json",
        "description": "Page-level discovery and entity-routing index for public knowledge pages."
