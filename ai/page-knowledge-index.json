---
layout: null
permalink: /ai/page-knowledge-index.json
sitemap: false
---
{
  "id": "https://dkharlanau.github.io/ai/page-knowledge-index.json#catalog",
  "type": "KnowledgePageCatalog",
  "updated_at": {{ site.time | date_to_xmlschema | jsonify }},
  "items": [
    {% assign knowledge_pages = site.pages | where_exp: "item", "item.ai_sidecar" | sort: "url" %}
    {% for item in knowledge_pages %}
    {
      "url": {{ item.url | absolute_url | jsonify }},
      "title": {{ item.title | jsonify }},
      "description": {{ item.description | default: item.summary | strip_html | normalize_whitespace | jsonify }},
      "primary_topic": {{ item.primary_topic | jsonify }},
      "search_intent": {{ item.search_intent | jsonify }},
      "last_reviewed": {{ item.last_reviewed | date_to_xmlschema | jsonify }},
      "sidecar": {{ item.ai_sidecar | absolute_url | jsonify }}
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
}
