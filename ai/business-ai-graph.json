---
layout: null
permalink: /ai/business-ai-graph.json
robots: noindex,follow
sitemap: false
---
{% assign contract = site.data.labs.business_ai.contract %}
{% assign catalog = site.data.labs.business_ai.catalog %}
{% assign domain_map = site.data.labs.business_ai.domain_map %}
{% assign process_map = site.data.labs.business_ai.process_map %}
{% assign scenarios = site.data.labs.business_ai.scenario_library %}
{% assign matrix = site.data.labs.business_ai.assessment_matrix %}
{% assign technologies = site.data.labs.business_ai.technology_landscape %}
{% assign sap_links = site.data.labs.business_ai.sap_process_links %}
{% assign expansion = site.data.labs.business_ai.expansion_2026_08_15 %}
{% assign expansion_b = site.data.labs.business_ai.expansion_2026_08_15_b %}
{% assign expansion_c = site.data.labs.business_ai.expansion_2026_08_15_c %}
{% assign empty_list = "" | split: "" %}
{% assign expansion_patterns = expansion.patterns | default: empty_list %}
{% assign expansion_b_patterns = expansion_b.patterns | default: empty_list %}
{% assign expansion_c_patterns = expansion_c.patterns | default: empty_list %}
{% assign expansion_cases = expansion.cases | default: empty_list %}
{% assign expansion_b_cases = expansion_b.cases | default: empty_list %}
{% assign expansion_c_cases = expansion_c.cases | default: empty_list %}
{% assign expansion_sources = expansion.source_registry | default: empty_list %}
{% assign expansion_b_sources = expansion_b.source_registry | default: empty_list %}
{% assign expansion_c_sources = expansion_c.source_registry | default: empty_list %}
{% assign scenario_sources = scenarios.source_registry | default: empty_list %}
{% assign all_patterns = catalog.patterns | concat: expansion_patterns | concat: expansion_b_patterns | concat: expansion_c_patterns %}
{% assign all_cases = catalog.cases | concat: expansion_cases | concat: expansion_b_cases | concat: expansion_c_cases %}
{% assign all_sources = catalog.source_registry | concat: expansion_sources | concat: expansion_b_sources | concat: expansion_c_sources | concat: scenario_sources %}
{% assign failure_patterns = scenarios.failure_patterns | default: empty_list %}
{% assign best_practices = scenarios.best_practices | default: empty_list %}
{
  "schema": "dkharlanau.business-ai.graph",
  "schema_version": "1.0",
  "contract_version": {{ contract.contract.version | jsonify }},
  "reviewed_at": {{ catalog.reviewed_at | jsonify }},
  "source_model": "_data/labs/business_ai/contract.yml",
  "case_contract": {
    "schema_version": {{ contract.case_schema.version | jsonify }},
    "migration_policy": {{ contract.case_schema.migration_policy | jsonify }},
    "agent_maximum_state": {{ contract.review_lifecycle.agent_maximum_state | jsonify }},
    "human_approval_state": {{ contract.review_lifecycle.human_approval_state | jsonify }},
    "review_lifecycle": {{ contract.review_lifecycle | jsonify }}
  },
  "normalization": {
    "legacy_case_kind": "unknown",
    "legacy_review_state": "Conservative inference: structured only when source IDs, a pattern, and evidence grade are present; sourced when only source IDs are present; otherwise candidate.",
    "legacy_implementation_maturity": "unknown",
    "legacy_measurement_state": "unknown",
    "legacy_transferability": "unknown",
    "legacy_source_confidence": "unknown",
    "legacy_evidence_level": "proof_gap",
    "sap_link_model": "Vendor-neutral process and stage IDs link to SAP-specific capability nodes. SAP pages remain the implementation source.",
    "note": "Generated defaults describe migration state only. They do not promote evidence to approved or runtime-proven status."
  },
  "manifest": {
    "canonical_sources": {{ contract.source_of_truth.datasets | jsonify }},
    "filtered_views": [
      "/labs/business-ai/data/catalog.json",
      "/labs/business-ai/data/domains.json",
      "/labs/business-ai/data/matrix.json",
      "/labs/business-ai/data/patterns.json",
      "/labs/business-ai/data/processes.json",
      "/labs/business-ai/data/scenarios.json",
      "/labs/business-ai/data/technologies.json"
    ]
  },
  "nodes": {
    "business_domains": [
      {% for node in domain_map.domains %}{% unless forloop.first %},{% endunless %}{"id":{{ node.id | jsonify }},"type":"BusinessDomain","title":{{ node.title | jsonify }},"case_ids":{{ node.case_ids | default: empty_list | jsonify }}}{% endfor %}
    ],
    "end_to_end_processes": [
      {% for node in process_map.processes %}{% unless forloop.first %},{% endunless %}{"id":{{ node.id | jsonify }},"type":"EndToEndProcess","title":{{ node.title | jsonify }},"domain_ids":{{ node.domains | default: empty_list | jsonify }},"pattern_ids":{{ node.pattern_ids | default: empty_list | jsonify }},"technology_family_ids":{{ node.technology_families | default: empty_list | jsonify }},"control_points":{{ node.control_points | default: empty_list | jsonify }},"legacy_stages":{{ node.stages | default: empty_list | jsonify }}}{% endfor %}
    ],
    "process_stages": [
      {% for node in sap_links.process_stages %}{% unless forloop.first %},{% endunless %}{"id":{{ node.id | jsonify }},"type":"ProcessStage","title":{{ node.title | jsonify }},"process_id":{{ node.process_id | jsonify }}}{% endfor %}
    ],
    "enterprise_capabilities": [
      {% for node in sap_links.capabilities %}{% unless forloop.first %},{% endunless %}{"id":{{ node.id | jsonify }},"type":"EnterpriseCapability","platform":{{ sap_links.platform | jsonify }},"title":{{ node.title | jsonify }},"family":{{ node.family | jsonify }},"canonical_url":{{ node.canonical_url | jsonify }},"operational_context_urls":{{ node.operational_context_urls | default: empty_list | jsonify }}}{% endfor %}
    ],
    "patterns": [
      {% for node in all_patterns %}{% unless forloop.first %},{% endunless %}{"id":{{ node.id | jsonify }},"type":"Pattern","title":{{ node.title | jsonify }},"business_job":{{ node.business_job | jsonify }},"automation_level":{{ node.automation_level | jsonify }}}{% endfor %}
    ],
    "technology_families": [
      {% for node in technologies.families %}{% unless forloop.first %},{% endunless %}{"id":{{ node.id | jsonify }},"type":"TechnologyFamily","title":{{ node.title | jsonify }},"job":{{ node.job | jsonify }}}{% endfor %}
    ],
    "cases": [
      {% for node in all_cases %}
      {% assign case_pattern_ids = node.pattern_ids | default: empty_list %}{% if case_pattern_ids == empty_list and node.pattern %}{% assign case_pattern_ids = node.pattern | split: "|" %}{% endif %}
      {% assign case_metrics = node.metrics | default: node.reported_metrics | default: empty_list %}
      {% assign case_limits = node.limitations | default: node.limits | default: empty_list %}
      {% assign case_note = node.consultant_interpretation | default: node.consultant_note %}
      {% assign inferred_state = node.review_state %}{% unless inferred_state %}{% if node.source_ids and node.pattern and node.evidence_grade %}{% assign inferred_state = "structured" %}{% elsif node.source_ids %}{% assign inferred_state = "sourced" %}{% else %}{% assign inferred_state = "candidate" %}{% endif %}{% endunless %}
      {% unless forloop.first %},{% endunless %}{"id":{{ node.id | jsonify }},"type":"BusinessAICase","title":{{ node.title | jsonify }},"case_kind":{{ node.case_kind | default: "unknown" | jsonify }},"review_state":{{ inferred_state | jsonify }},"business_problem":{{ node.business_problem | jsonify }},"company":{{ node.company | jsonify }},"industry":{{ node.industry | jsonify }},"process_label":{{ node.process_label | default: node.process | jsonify }},"process_id":{{ node.process_id | jsonify }},"process_stage_ids":{{ node.process_stage_ids | default: empty_list | jsonify }},"ai_job":{{ node.ai_job | jsonify }},"pattern_ids":{{ case_pattern_ids | jsonify }},"implementation_maturity":{{ node.implementation_maturity | default: "unknown" | jsonify }},"implementation_summary":{{ node.implementation_summary | default: node.implementation | jsonify }},"autonomy_level":{{ node.autonomy_level | jsonify }},"systems_of_record":{{ node.systems_of_record | default: empty_list | jsonify }},"data_dependencies":{{ node.data_dependencies | default: empty_list | jsonify }},"integration_boundaries":{{ node.integration_boundaries | default: empty_list | jsonify }},"authority_boundary":{{ node.authority_boundary | jsonify }},"controls":{{ node.controls | default: empty_list | jsonify }},"human_review":{{ node.human_review | jsonify }},"metrics":{{ case_metrics | jsonify }},"measurement_state":{{ node.measurement_state | default: "unknown" | jsonify }},"evidence_grade":{{ node.evidence_grade | jsonify }},"evidence_claims":{{ node.evidence_claims | default: empty_list | jsonify }},"source_ids":{{ node.source_ids | default: empty_list | jsonify }},"source_types":{{ node.source_types | default: empty_list | jsonify }},"limitations":{{ case_limits | jsonify }},"proof_gaps":{{ node.proof_gaps | default: empty_list | jsonify }},"transferability":{{ node.transferability | default: "unknown" | jsonify }},"failure_notes":{{ node.failure_notes | default: empty_list | jsonify }},"consultant_interpretation":{{ case_note | jsonify }},"canonical_url":{{ "/labs/business-ai/cases/#" | append: node.id | jsonify }}}{% endfor %}
    ],
    "scenario_outcomes": [
      {% for node in scenarios.scenarios %}{% unless forloop.first %},{% endunless %}{"id":{{ node.id | jsonify }},"type":"ScenarioOutcome","outcome_state":"unknown","status":{{ node.status | jsonify }},"company":{{ node.company | jsonify }},"process":{{ node.process | jsonify }},"source_ids":{{ node.source_ids | default: empty_list | jsonify }}}{% endfor %}
    ],
    "failure_patterns": [
      {% for node in failure_patterns %}{% unless forloop.first %},{% endunless %}{"id":{{ node.id | jsonify }},"type":"FailurePattern","title":{{ node.title | jsonify }},"problem":{{ node.problem | jsonify }}}{% endfor %}
    ],
    "best_practices": [
      {% for node in best_practices %}{% unless forloop.first %},{% endunless %}{"id":{{ node.id | jsonify }},"type":"BestPractice","title":{{ node.title | jsonify }},"practice":{{ node.practice | jsonify }},"source_ids":{{ node.source_ids | default: empty_list | jsonify }}}{% endfor %}
    ],
    "decision_profiles": [
      {% for node in matrix.profiles %}{% unless forloop.first %},{% endunless %}{"id":{{ node.id | jsonify }},"type":"DecisionProfile","process":{{ node.process | jsonify }},"pattern_ids":{{ node.pattern_ids | default: empty_list | jsonify }},"autonomy_level":{{ node.recommended_autonomy | jsonify }},"risk_class":{{ node.risk_class | jsonify }},"failure_pattern_ids":{{ node.failure_pattern_ids | default: empty_list | jsonify }},"scenario_ids":{{ node.scenario_ids | default: empty_list | jsonify }},"required_controls":{{ node.required_controls | default: empty_list | jsonify }}}{% endfor %}
    ],
    "evidence_sources": [
      {% for node in all_sources %}{% unless forloop.first %},{% endunless %}{"id":{{ node.id | jsonify }},"type":"EvidenceSource","source_confidence":{{ node.source_confidence | default: "unknown" | jsonify }},"evidence_level":{{ node.evidence_level | default: "proof_gap" | jsonify }},"record":{{ node | jsonify }}}{% endfor %}
    ]
  },
  "edges": {
    "process-crosses-domain": [
      {% assign first_edge = true %}{% for process in process_map.processes %}{% for target_id in process.domains %}{% unless first_edge %},{% endunless %}{"id":{{ process.id | append: "-domain-" | append: target_id | jsonify }},"type":"process-crosses-domain","from":{{ process.id | jsonify }},"to":{{ target_id | jsonify }}}{% assign first_edge = false %}{% endfor %}{% endfor %}
    ],
    "process-has-stage": [
      {% for stage in sap_links.process_stages %}{% unless forloop.first %},{% endunless %}{"id":{{ stage.process_id | append: "-stage-" | append: stage.id | jsonify }},"type":"process-has-stage","from":{{ stage.process_id | jsonify }},"to":{{ stage.id | jsonify }}}{% endfor %}
    ],
    "process-uses-pattern": [
      {% assign first_edge = true %}{% for process in process_map.processes %}{% for target_id in process.pattern_ids %}{% unless first_edge %},{% endunless %}{"id":{{ process.id | append: "-pattern-" | append: target_id | jsonify }},"type":"process-uses-pattern","from":{{ process.id | jsonify }},"to":{{ target_id | jsonify }}}{% assign first_edge = false %}{% endfor %}{% endfor %}
    ],
    "stage-maps-to-capability": [
      {% for link in sap_links.stage_links %}{% unless forloop.first %},{% endunless %}{"id":{{ link.id | jsonify }},"type":"stage-maps-to-capability","from":{{ link.stage_id | jsonify }},"to":{{ link.capability_id | jsonify }},"decision_points":{{ link.decision_points | default: empty_list | jsonify }},"deterministic_rules":{{ link.deterministic_rules | default: empty_list | jsonify }},"data_dependencies":{{ link.data_dependencies | default: empty_list | jsonify }},"integration_boundaries":{{ link.integration_boundaries | default: empty_list | jsonify }},"authority":{{ link.authority | jsonify }},"control_points":{{ link.control_points | default: empty_list | jsonify }}}{% endfor %}
    ],
    "domain-maps-to-capability": [
      {% for link in sap_links.domain_links %}{% unless forloop.first %},{% endunless %}{"id":{{ link.id | jsonify }},"type":"domain-maps-to-capability","from":{{ link.domain_id | jsonify }},"to":{{ link.capability_id | jsonify }},"decision_points":{{ link.decision_points | default: empty_list | jsonify }},"deterministic_rules":{{ link.deterministic_rules | default: empty_list | jsonify }},"data_dependencies":{{ link.data_dependencies | default: empty_list | jsonify }},"integration_boundaries":{{ link.integration_boundaries | default: empty_list | jsonify }},"authority":{{ link.authority | jsonify }},"control_points":{{ link.control_points | default: empty_list | jsonify }}}{% endfor %}
    ],
    "domain-supports-case": [
      {% assign first_edge = true %}{% for domain in domain_map.domains %}{% for target_id in domain.case_ids %}{% unless first_edge %},{% endunless %}{"id":{{ domain.id | append: "-case-" | append: target_id | jsonify }},"type":"domain-supports-case","from":{{ domain.id | jsonify }},"to":{{ target_id | jsonify }}}{% assign first_edge = false %}{% endfor %}{% endfor %}
    ],
    "case-uses-pattern": [
      {% assign first_edge = true %}{% for case in all_cases %}{% assign pattern_id = case.pattern %}{% if pattern_id %}{% unless first_edge %},{% endunless %}{"id":{{ case.id | append: "-pattern-" | append: pattern_id | jsonify }},"type":"case-uses-pattern","from":{{ case.id | jsonify }},"to":{{ pattern_id | jsonify }}}{% assign first_edge = false %}{% endif %}{% endfor %}
    ],
    "decision-tests-failure": [
      {% assign first_edge = true %}{% for profile in matrix.profiles %}{% for target_id in profile.failure_pattern_ids %}{% unless first_edge %},{% endunless %}{"id":{{ profile.id | append: "-failure-" | append: target_id | jsonify }},"type":"decision-tests-failure","from":{{ profile.id | jsonify }},"to":{{ target_id | jsonify }}}{% assign first_edge = false %}{% endfor %}{% endfor %}
    ],
    "decision-supported-by-outcome": [
      {% assign first_edge = true %}{% for profile in matrix.profiles %}{% for target_id in profile.scenario_ids %}{% unless first_edge %},{% endunless %}{"id":{{ profile.id | append: "-outcome-" | append: target_id | jsonify }},"type":"decision-supported-by-outcome","from":{{ profile.id | jsonify }},"to":{{ target_id | jsonify }}}{% assign first_edge = false %}{% endfor %}{% endfor %}
    ]
  },
  "proof_gaps": [
    "Priority SAP process stages now have stable graph IDs; remaining legacy process stages are still strings until later normalization.",
    "Legacy case process labels are not yet normalized to EndToEndProcess IDs.",
    "Legacy case kind, implementation maturity, measurement state, and transferability remain unknown until reviewed evidence supports them.",
    "Scenario outcome_state remains unknown until legacy scenario status is explicitly mapped.",
    "Legacy evidence sources default to unknown confidence and proof_gap until source records are reviewed against the normalized contract."
  ],
  "platform_boundaries": {
    "sap": {{ sap_links.non_sap_usage | jsonify }}
  }
}
