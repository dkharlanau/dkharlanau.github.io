{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dkharlanau.github.io/labs/assessment/data/case-schema.json",
  "title": "SAP Lead Assessment Case",
  "type": "object",
  "required": [
    "id",
    "track",
    "level",
    "title",
    "prompt",
    "expected_points",
    "follow_up_questions",
    "red_flags",
    "graph_refs",
    "human_refs"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ASSESS-[A-Z]+-[0-9]{3}$"
    },
    "track": {
      "type": "string",
      "enum": ["sales", "procurement-logistics", "integration-architecture", "ai-data"]
    },
    "level": {
      "type": "string",
      "enum": ["explain", "trace", "diagnose", "design", "challenge"]
    },
    "title": {
      "type": "string",
      "minLength": 5
    },
    "prompt": {
      "type": "string",
      "minLength": 20
    },
    "expected_points": {
      "type": "array",
      "minItems": 3,
      "items": {"type": "string", "minLength": 3}
    },
    "follow_up_questions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 5}
    },
    "red_flags": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 3}
    },
    "graph_refs": {
      "type": "array",
      "items": {"type": "string"}
    },
    "human_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^/"}
    }
  },
  "additionalProperties": false
}
