{
  "id": "sap-lead-assessment-lab",
  "version": "0.2.1",
  "updated_at": "2026-08-16",
  "status": "draft",
  "purpose": "Turn the existing Lab into a structured SAP Lead assessment practice route across process knowledge, diagnostics, architecture, integration, data, and AI.",
  "reasoning_levels": [
    {
      "id": "explain",
      "label": "Explain",
      "goal": "Describe business purpose, process flow, key objects, and system boundary in clear language."
    },
    {
      "id": "trace",
      "label": "Trace",
      "goal": "Follow one requirement through master data, configuration, documents, integrations, and business impact."
    },
    {
      "id": "diagnose",
      "label": "Diagnose",
      "goal": "Start from a symptom, build hypotheses, find the first wrong decision, and define proof of fix."
    },
    {
      "id": "design",
      "label": "Design",
      "goal": "Choose ownership, component boundaries, integration style, controls, and extension approach."
    },
    {
      "id": "challenge",
      "label": "Challenge",
      "goal": "Explain trade-offs, limits, failure modes, alternatives, and decision-changing conditions."
    }
  ],
