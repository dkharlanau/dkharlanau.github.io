{
  "id": "sap-lead-candidate-generation-seeds",
  "version": "1.0.0",
  "updated_at": "2026-08-16",
  "purpose": "Whitelist graph failure modes and their primary-source evidence for deterministic assessment-question candidate generation.",
  "graphs": [
    {
      "path": "_data/labs/enterprise_context/graphs/billing.yml",
      "human_ref": "/labs/enterprise-context/billing/",
      "track": "sales",
      "level": "diagnose",
      "candidate_prefix": "CAND-BIL",
      "failure_sources": {
        "FAIL-SD-BILLING-NOT-DUE": ["SRC-SAP-BIL-DUE-LIST", "SRC-SAP-BIL-PROCESSING"],
        "FAIL-SD-BILLING-WRONG-REFERENCE": ["SRC-SAP-BIL-COPYING-CONTROL", "SRC-SAP-BIL-PROCESSING"],
        "FAIL-SD-BILLING-SPLIT": ["SRC-SAP-BIL-SPLIT", "SRC-SAP-BIL-SPLIT-ANALYSIS"],
        "FAIL-SD-BILLING-PRICE": ["SRC-SAP-BIL-PRICING"],
        "FAIL-SD-BILLING-FI": ["SRC-SAP-BIL-ACCOUNT-DETERMINATION", "SRC-SAP-BIL-TYPE"],
        "FAIL-SD-BILLING-EXTERNAL": ["SRC-SAP-BIL-EDOCUMENT"],
        "FAIL-SD-BILLING-CORRECTION": ["SRC-SAP-BIL-CREDIT-DEBIT", "SRC-SAP-BIL-CANCEL-API", "SRC-SAP-BIL-PROCESSING"]
      }
    },
    {
      "path": "_data/labs/enterprise_context/graphs/integration_operations.yml",
      "human_ref": "/labs/enterprise-context/integration-operations/",
      "track": "integration-architecture",
      "level": "diagnose",
      "candidate_prefix": "CAND-INTOPS",
      "failure_sources": {
        "INTOPS-FAIL-GREEN-NO-BUSINESS": ["SRC-SAP-INTOPS-CI-MONITOR", "SRC-SAP-INTOPS-ERROR-DESIGN"],
        "INTOPS-FAIL-DUPLICATE": ["SRC-SAP-INTOPS-EXACTLY-ONCE", "SRC-SAP-INTOPS-QUEUES"],
        "INTOPS-FAIL-ORDER": ["SRC-SAP-INTOPS-QRFC", "SRC-SAP-INTOPS-BGRFC"],
        "INTOPS-FAIL-RETRY-STORM": ["SRC-SAP-INTOPS-ERROR-DESIGN", "SRC-SAP-INTOPS-QUEUES"],
        "INTOPS-FAIL-PARTIAL-COMMIT": ["SRC-SAP-INTOPS-EXACTLY-ONCE", "SRC-SAP-INTOPS-AIF-ERROR"],
        "INTOPS-FAIL-QUEUE-BLOCK": ["SRC-SAP-INTOPS-QRFC", "SRC-SAP-INTOPS-QRFC-STATUS"],
        "INTOPS-FAIL-OWNERSHIP": ["SRC-SAP-INTOPS-AIF-ERROR", "SRC-SAP-INTOPS-ERROR-DESIGN"]
      }
    }
  ],
  "dedup_threshold": 0.46,
  "publication_rule": "Generated records never enter case-sets.json automatically. Only a separately reviewed and promoted case can become part of the published assessment dataset."
}
