---
layout: null
permalink: /blog/feed.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.title | xml_escape }} | Blog</title>
    <link>{{ '/blog/' | absolute_url }}</link>
    <description>Reviewed and verified long-form publications from {{ site.author.name | xml_escape }}.</description>
    <language>{{ site.lang | default: 'en' }}</language>
    <atom:link href="{{ page.url | absolute_url }}" rel="self" type="application/rss+xml" />
    {% assign entries = site.blog | where: 'verified', true | where: 'status', 'reviewed' | sort: 'date' | reverse %}
    {% for entry in entries limit: 20 %}
      {% unless entry.robots contains 'noindex' %}
        {% unless entry.sitemap == false %}
    <item>
      <title>{{ entry.title | xml_escape }}</title>
      <link>{{ entry.url | absolute_url }}</link>
      <guid isPermaLink="true">{{ entry.url | absolute_url }}</guid>
      <pubDate>{{ entry.date | date_to_rfc822 }}</pubDate>
      <description>{{ entry.description | default: entry.excerpt | strip_html | normalize_whitespace | xml_escape }}</description>
    </item>
        {% endunless %}
      {% endunless %}
    {% endfor %}
  </channel>
</rss>
